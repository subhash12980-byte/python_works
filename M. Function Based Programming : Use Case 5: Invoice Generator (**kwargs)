def generate_invoice(**products):
  total = 0

  print("\nInvoice")
  print("-" * 20)

  for product, price in products.items():
     print(f"{product} : ₹{price}")
     total += price

  print("-" * 20)
  print(f"Total Amount : ₹{total}")

generate_invoice(
Soap=50,
Oil=100,
Powder=200,
Tea=250,
Coffee=400
)
 
